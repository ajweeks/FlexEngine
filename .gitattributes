# Normalize to LF in the repo; check out as CRLF (the project standard). Agents must not change a file's line endings (flexsvc done checks)
* text=auto eol=crlf

# Custom for Visual Studio
*.cs    diff=csharp

# Standard to msysgit
*.doc	diff=astextplain
*.DOC	diff=astextplain
*.docx 	diff=astextplain
*.DOCX 	diff=astextplain
*.dot	diff=astextplain
*.DOT  	diff=astextplain
*.pdf   diff=astextplain
*.PDF	diff=astextplain
*.rtf	diff=astextplain
*.RTF	diff=astextplain

FlexEngine/dependencies/* linguist-vendored

FlexEngine/include/ThirdParty/* linguist-vendored
FlexEngine/src/ThirdParty/* linguist-vendored

# Save file test fixtures must stay byte for byte
FlexEngine/resources/tests/save_files/** -text

# Scripts run from WSL/Linux need LF (a CRLF shebang breaks them)
*.sh text eol=lf
*.py text eol=lf
scripts/flexsvc text eol=lf
scripts/genie -text

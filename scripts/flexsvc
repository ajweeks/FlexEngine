#!/usr/bin/env python3
"""flexsvc: shared build/run service & message board for agents working on Flex concurrently (run from WSL).

Every agent passes its own name (-a NAME, or FLEX_AGENT=NAME). See docs/agents.md for the full guide.

  flexsvc -a NAME build [--linux] [--mine] [--until-ok] [--max S]   build the tree as it is now (queued, cached)
  flexsvc -a NAME run [--perf] [--timeout S] [--env K=V] [--fresh] [--build ID|--last-good] [--detach] [--grep RE] -- <args>
  flexsvc -a NAME wait TICKET [--max S]                    output of a `run --detach`
  flexsvc -a NAME bench [--seconds S] [--baseline BUILD_ID|file.json] [--env K=V] [--baseline-env K=V]
  flexsvc -a NAME hold | release                           make builds wait while you save a multi-file edit
  flexsvc -a NAME pin BUILD_ID                             keep a build past pruning
  flexsvc -a NAME post [--to AGENT|PATH] MESSAGE           post to the board (or to whoever claimed PATH)
  flexsvc -a NAME read|board [--all|--undelivered]        unread board messages (also shown by build/run)
  flexsvc -a NAME claim [--set|--clear] PATH...            add to the files you're working on (--set replaces)
  flexsvc -a NAME shaders [NAME...]                        compile changed (or named) shaders into saved/spv
  flexsvc -a NAME shots ref|diff SET                       save / compare the last run's screenshots
  flexsvc -a NAME kill                                     kill Flex.exe processes left in your sandbox
  flexsvc -a NAME done                                     pre-report check: build passes with your edits, no DBG: prints
  flexsvc status | hooks | scratch | metrics               queue/activity, test hook catalogue, scratch dir, dispatch stats

State lives in $FLEXSVC_HOME (default C:\\Code\\Flex\\agents): board.md, builds/, sandboxes/<agent>/, scratch/<agent>/.
Each agent's exe runs in its own sandbox (bin/<build id>/FlexEngine/Flex.exe beside a FlexEngine/ folder whose
resources/ & config/ link to the repo & whose saved/ is private, except saved/spv & saved/fonts which are shared),
so several instances can run at once without sharing logs, settings, worlds or caches.
"""

import argparse, contextlib, fcntl, fnmatch, glob, hashlib, json, os, re, shlex, shutil, subprocess, sys, time

REPO = os.path.realpath(os.path.join(os.path.dirname(os.path.abspath(__file__)), ".."))
ENGINE = os.path.join(REPO, "FlexEngine")
HOME = os.environ.get("FLEXSVC_HOME", os.path.join(os.path.dirname(REPO), "agents"))
LOCKS = os.environ.get("FLEXSVC_LOCKS", "/tmp/flexsvc-locks")  # flock needs a Linux filesystem
GPU_SLOTS = int(os.environ.get("FLEXSVC_GPU_SLOTS", "3"))
KEEP_BUILDS = 40
MSBUILD_GLOB = "/mnt/c/Program Files/Microsoft Visual Studio/*/*/MSBuild/Current/Bin/amd64/MSBuild.exe"
SRC_EXTS = (".cpp", ".c", ".h", ".hpp")

AGENT = None


def die(msg, code=2):
	print("flexsvc: " + msg, file=sys.stderr)
	sys.exit(code)


def winpath(p):
	return subprocess.check_output(["wslpath", "-w", p], text=True).strip()


def now_str():
	return time.strftime("%H:%M:%S")


def read_json(path, default=None):
	try:
		with open(path) as f:
			return json.load(f)
	except (OSError, ValueError):
		return default


def write_json(path, data):
	tmp = path + ".tmp"
	with open(tmp, "w") as f:
		json.dump(data, f, indent=1)
	os.replace(tmp, path)


# ---------------------------------------------------------------- locks & activity

@contextlib.contextmanager
def lock(name, shared=False, what=None):
	"""Blocking flock. While waiting & holding, an activity file says who's doing what (see `status`)."""
	os.makedirs(os.path.join(LOCKS, "activity"), exist_ok=True)
	f = open(os.path.join(LOCKS, name + ".lock"), "a+")
	act = os.path.join(LOCKS, "activity", "%d-%s.json" % (os.getpid(), name))
	info = {"agent": AGENT, "lock": name, "what": what or name, "pid": os.getpid(), "since": time.time()}
	try:
		fcntl.flock(f, (fcntl.LOCK_SH if shared else fcntl.LOCK_EX) | fcntl.LOCK_NB)
	except BlockingIOError:
		write_json(act, dict(info, state="waiting"))
		print("[%s] waiting for %s lock%s..." % (now_str(), name, lock_holders(name)), flush=True)
		fcntl.flock(f, fcntl.LOCK_SH if shared else fcntl.LOCK_EX)
	write_json(act, dict(info, state="holding", since=time.time()))
	try:
		yield
	finally:
		with contextlib.suppress(OSError):
			os.remove(act)
		fcntl.flock(f, fcntl.LOCK_UN)
		f.close()


def lock_holders(name):
	"""' (held by X: what, 120s; use `run --detach` to keep working)' for a waiting message, so long waits are explained."""
	held = []
	for p in glob.glob(os.path.join(LOCKS, "activity", "*-%s.json" % name)):
		a = read_json(p)
		if a and a.get("state") == "holding" and a.get("pid") != os.getpid() and os.path.exists("/proc/%d" % a["pid"]):
			held.append("%s: %s, %.0fs" % (a["agent"], a["what"][:50], time.time() - a["since"]))
	return " (held by %s; `run --detach` to keep working meanwhile)" % "; ".join(held) if held else ""


@contextlib.contextmanager
def machine(exclusive, what):
	"""Builds & normal runs share the machine; perf runs get it to themselves. The gate stops a stream of shared
	holders from starving a waiting perf run."""
	if exclusive:
		with lock("gate", what=what), lock("machine", what=what):
			yield
	else:
		with lock("gate", what=what):
			pass
		with lock("machine", shared=True, what=what):
			yield


@contextlib.contextmanager
def gpu_slot(what):
	files = []
	for i in range(GPU_SLOTS):
		files.append(open(os.path.join(LOCKS, "gpu%d.lock" % i), "a+"))
	held = None
	announced = False
	while held is None:
		for f in files:
			try:
				fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
				held = f
				break
			except BlockingIOError:
				pass
		if held is None:
			if not announced:
				print("[%s] all %d GPU slots busy, waiting..." % (now_str(), GPU_SLOTS), flush=True)
				announced = True
			time.sleep(1.0)
	try:
		with lock("slot-%d" % files.index(held), what=what):  # only for `status`; never contended
			yield
	finally:
		for f in files:
			f.close()


# ---------------------------------------------------------------- board

def history(event, **fields):
	"""One line per build/done in <HOME>/history.jsonl (archived with the board), for `metrics`."""
	with open(os.path.join(HOME, "history.jsonl"), "a") as f:
		f.write(json.dumps(dict(event=event, t=time.time(), agent=AGENT, **fields)) + "\n")


def board_path():
	return os.path.join(HOME, "board.md")


def claims():
	return read_json(os.path.join(HOME, "claims.json"), {})


def post(msg, to=None, sender=None):
	os.makedirs(HOME, exist_ok=True)
	msg = " ".join(msg.split("\n"))
	line = "- [%s %s] **%s**%s: %s\n" % (time.strftime("%m-%d"), now_str(), sender or AGENT, (" → " + to) if to else "", msg)
	with lock("board"):
		with open(board_path(), "a") as f:
			f.write(line)
	if to and to != "all" and sender is None:
		for agent in recipients(to):
			cur = os.path.join(HOME, "cursors", agent)
			if not os.path.exists(cur):
				print("note: %s hasn't read the board yet; the manager can see undelivered posts with `read --undelivered`" % agent)
			elif time.time() - os.path.getmtime(cur) > 900:
				print("note: %s hasn't read the board for %.0f min and may have finished; the manager can see it with `read --undelivered`" % (agent, (time.time() - os.path.getmtime(cur)) / 60))


def recipients(to):
	"""Agents a directed post reaches: whoever claimed a matching path, else the named agent."""
	allc = claims()
	if to in allc or os.path.exists(os.path.join(HOME, "cursors", to)):
		return [to]
	agents = [a for a, paths in allc.items() if any(fnmatch.fnmatch(c, "*" + to + "*") or fnmatch.fnmatch(to, "*" + c + "*") for c in paths)]
	return agents or [to]


def cursor_of(agent):
	cur = os.path.join(HOME, "cursors", agent)
	try:
		return int(open(cur).read().strip() or 0)
	except (OSError, ValueError):
		return 0


def addressed_to_me(sender, to):
	if sender == AGENT:
		return False
	if not to:
		return True
	if to in (AGENT, "all"):
		return True
	mine = claims().get(AGENT, [])
	return any(fnmatch.fnmatch(c, "*" + to + "*") or fnmatch.fnmatch(to, "*" + c + "*") for c in mine)


def unread(show_all=False):
	"""Board lines for this agent that it hasn't been shown yet."""
	try:
		with open(board_path()) as f:
			lines = f.readlines()
	except OSError:
		return []
	cursor_file = os.path.join(HOME, "cursors", AGENT)
	start = 0 if show_all else int((open(cursor_file).read().strip() or 0) if os.path.exists(cursor_file) else 0)
	out = []
	for line in lines[start:]:
		m = re.match(r"- \[[^\]]*\] \*\*([^*]+)\*\*(?: → ([^:]+))?:", line)
		if m is None or addressed_to_me(m.group(1), m.group(2)) or show_all:
			out.append(line.rstrip())
	os.makedirs(os.path.dirname(cursor_file), exist_ok=True)
	with open(cursor_file, "w") as f:
		f.write(str(len(lines)))
	return out


def undelivered():
	"""Directed messages whose addressee hasn't read past them (for the manager to relay)."""
	try:
		lines = open(board_path()).readlines()
	except OSError:
		return []
	out = []
	for i, line in enumerate(lines):
		m = re.match(r"- \[[^\]]*\] \*\*([^*]+)\*\*(?: → ([^:]+))?:", line)
		if not m or not m.group(2) or m.group(2) == "all":
			continue
		missed = [a for a in recipients(m.group(2)) if a != m.group(1) and cursor_of(a) <= i]
		if missed:
			out.append("(not read by %s) %s" % (", ".join(missed), line.rstrip()))
	return out


def show_unread():
	msgs = unread()
	if msgs:
		print("=== New on the board (%s) ===" % board_path())
		print("\n".join(msgs))
		print("===")


# ---------------------------------------------------------------- build

def source_files():
	out = []
	for top in ("src", "include"):
		for root, _, names in os.walk(os.path.join(ENGINE, top)):
			out += [os.path.join(root, n) for n in names if n.endswith(SRC_EXTS)]
	return out


def spv_files():
	return glob.glob(os.path.join(ENGINE, "saved", "spv", "*.spv"))


def fingerprint(files):
	h = hashlib.sha1()
	newest = 0.0
	for p in sorted(spv_files()):  # shaders compiled since the last build make a new build (each snapshots its spv)
		with contextlib.suppress(OSError):
			st = os.stat(p)
			h.update(("%s|%d|%d\n" % (p, st.st_size, st.st_mtime_ns)).encode())
	for p in sorted(files + [os.path.join(REPO, "scripts", "genie.lua")]):
		with contextlib.suppress(OSError):
			st = os.stat(p)
			h.update(("%s|%d|%d\n" % (p, st.st_size, st.st_mtime_ns)).encode())
			newest = max(newest, st.st_mtime)
	return h.hexdigest()[:16], newest


def projects_stale(files):
	"""Source files on disk that the VS project doesn't list (or vice versa)."""
	try:
		with open(os.path.join(REPO, "build", "Flex.vcxproj"), encoding="utf-8", errors="replace") as f:
			proj = f.read()
	except OSError:
		return ["(no build/Flex.vcxproj)"], []
	listed = set(m.replace("\\", "/") for m in re.findall(r'Include="\.\.\\FlexEngine\\((?:src|include)\\[^"]+)"', proj))
	on_disk = set(os.path.relpath(p, ENGINE).replace("\\", "/") for p in files)
	return sorted(on_disk - listed), sorted(listed - on_disk)


def regenerate_projects(added, removed):
	scripts = os.path.join(REPO, "scripts")
	print("[%s] source list changed (+%s -%s), regenerating projects" % (now_str(), added[:5], removed[:5]), flush=True)
	for cmd in (["./genie.exe", "--file=genie.lua", "vs2026"], ["./genie", "--file=genie.lua", "ninja"]):
		r = subprocess.run(cmd, cwd=scripts, capture_output=True, text=True)
		if r.returncode != 0:
			die("genie failed: %s\n%s%s" % (" ".join(cmd), r.stdout, r.stderr), 1)
	post("regenerated projects (added %s, removed %s)" % (", ".join(added) or "-", ", ".join(removed) or "-"), sender="flexsvc")


def error_lines(output, linux=False):
	pat = re.compile(r"(error|fatal|LNK\d{4}|undefined reference|multiple definition)", re.I)
	seen, out = set(), []
	for line in output.splitlines():
		line = re.sub(r"\s*\[[^\]]*\.vcxproj\]\s*$", "", line.strip())
		if pat.search(line) and "warning" not in line.lower() and line not in seen:
			seen.add(line)
			out.append(line.replace(winpath(REPO) + "\\", "") if not linux else line.replace(REPO + "/", ""))
	return out


def hold_file():
	return os.path.join(HOME, "hold.json")


def wait_for_hold(max_wait=90):  # keeps a build/run under the 120 s tool timeout
	"""While another agent holds (mid multi-file edit), wait rather than build half an edit. Holds expire."""
	t0 = time.time()
	announced = False
	while time.time() - t0 < max_wait:
		h = read_json(hold_file())
		if not h or h.get("agent") == AGENT or time.time() - h.get("since", 0) > 600:
			return
		if not announced:
			print("[%s] %s is holding builds (mid-edit), waiting up to %ds..." % (now_str(), h.get("agent"), max_wait), flush=True)
			announced = True
		time.sleep(3)
	print("[%s] hold still active after %ds, building anyway" % (now_str(), max_wait), flush=True)


def changed_since(files, t):
	return [p for p in files if os.path.exists(p) and os.path.getmtime(p) > t]


def build(config="Release", linux=False, quiet_cached=False):
	"""Builds the tree as it stands now. Requests that queue up behind a running build are served by the next build
	(which starts after they asked), so N agents asking at once cost one or two builds. Returns the state dict."""
	requested = time.time()
	key = "linux-debug" if linux else config
	state_file = os.path.join(HOME, "builds", key + ".json")
	os.makedirs(os.path.dirname(state_file), exist_ok=True)

	wait_for_hold()
	with machine(False, "build " + key), lock("build-" + key, what="build " + key):
		files = source_files()
		fp, newest_src = fingerprint(files)
		last = read_json(state_file, {})
		if last and (last.get("fingerprint") == fp or last.get("started", 0) >= requested):
			if not quiet_cached:
				print("[%s] cached %s build %s (%s; newest source change %s)" % (now_str(), key, last.get("id"), "unchanged sources" if last.get("fingerprint") == fp else "started after you asked", time.strftime("%H:%M:%S", time.localtime(newest_src))))
			return last

		if not linux:
			added, removed = projects_stale(files)
			if added or removed:
				regenerate_projects(added, removed)
				files = source_files()
				fp, newest_src = fingerprint(files)

		n = (last.get("n", 0) if last else 0) + 1
		build_id = "%s-%d" % ("lin" if linux else config[0].lower(), n)
		started = time.time()
		print("[%s] building %s (%s)..." % (now_str(), key, build_id), flush=True)
		if linux:
			cmd = ["nice", "-n", "10", "ninja", "-C", os.path.join(REPO, "build", "debug64"), "-j", str(max(2, (os.cpu_count() or 4) // 2))]
			cwd = REPO
		else:
			msbuild = sorted(glob.glob(MSBUILD_GLOB))
			if not msbuild:
				die("MSBuild.exe not found (%s)" % MSBUILD_GLOB)
			cmd = [msbuild[-1], "Flex.sln", "/p:Configuration=" + config, "/p:Platform=x64", "/m", "/v:minimal", "/nologo"]
			cwd = os.path.join(REPO, "build")
		r = subprocess.run(cmd, cwd=cwd, capture_output=True, text=True, errors="replace", stdin=subprocess.DEVNULL)
		output = (r.stdout + r.stderr).replace("\r", "")
		log = os.path.join(HOME, "builds", build_id + ".log")
		with open(log, "w") as f:
			f.write(output)

		errors = error_lines(output, linux)
		late = changed_since(files, started)
		state = {"id": build_id, "n": n, "config": key, "fingerprint": fp, "started": started, "seconds": round(time.time() - started, 1),
			"ok": r.returncode == 0 and not errors, "errors": errors[:40], "log": log, "by": AGENT, "newest_src": newest_src}
		if late:
			# Edited while compiling: objects may be stale. Touch them so the next build recompiles them, and don't trust this one.
			state["dirty"] = [os.path.relpath(p, ENGINE) for p in late[:10]]
			for p in late:
				with contextlib.suppress(OSError):
					os.utime(p)
			state["fingerprint"] = "dirty"
			print("[%s] WARNING: %d source file(s) changed during the build (%s): treat %s as unreliable, rebuild" % (now_str(), len(late), ", ".join(state["dirty"][:3]), build_id), flush=True)
		if r.returncode != 0 and not errors:
			state["errors"] = ["build exited with %d but printed no error lines, see %s" % (r.returncode, log)]

		if state["ok"] and not linux:
			out_dir = os.path.join(REPO, "bin", config + "_x64", "FlexEngine")
			exe = os.path.join(out_dir, "Flex.exe")
			# A link that silently didn't happen leaves the old exe behind: the exe must be newer than every source
			if not os.path.exists(exe) or os.path.getmtime(exe) + 1.0 < newest_src:
				state["ok"] = False
				state["errors"] = ["Flex.exe is older than the newest source file, the link didn't happen (see %s)" % log]
			else:
				snap = os.path.join(HOME, "builds", build_id)
				os.makedirs(snap, exist_ok=True)
				for name in os.listdir(out_dir):
					if name.lower().endswith((".exe", ".dll", ".pdb")):
						shutil.copy2(os.path.join(out_dir, name), snap)
				state["dir"] = snap
				spv_snap = os.path.join(snap, "spv")  # each build runs with the shaders it was built with
				os.makedirs(spv_snap, exist_ok=True)
				for p in spv_files():
					shutil.copy2(p, spv_snap)
		elif state["ok"]:
			state["dir"] = os.path.join(REPO, "bin", "Debug_x64", "FlexEngine")

		if last and last.get("ok") != state["ok"]:
			if state["ok"]:
				post("%s build fixed (%s)" % (key, build_id), sender="flexsvc")
			else:
				post("%s build BROKEN (%s, first error: %s)" % (key, build_id, state["errors"][0][:200]), sender="flexsvc")
		write_json(state_file, state)
		history("build", id=build_id, config=key, started=started, seconds=state["seconds"], ok=state["ok"])
		if state["ok"] and not linux and not late:
			write_json(os.path.join(HOME, "builds", key + "-good.json"), state)
		prune_builds()
		return state


def build_mine():
	"""Compile only the .cpp files you claimed (Linux ninja, compile check) before saving into shared files."""
	cpps = [os.path.basename(p) for p in claims().get(AGENT, []) if p.endswith(".cpp")]
	if not cpps:
		die("no claimed .cpp files (flexsvc claim PATH...)")
	bd = os.path.join(REPO, "build", "debug64")
	targets = subprocess.run(["ninja", "-C", bd, "-t", "targets", "all"], capture_output=True, text=True).stdout.splitlines()
	names = set(os.path.splitext(c)[0] + ".o" for c in cpps) | set(c + ".o" for c in cpps)
	objs = [t.split(":")[0] for t in targets if os.path.basename(t.split(":")[0]) in names]
	if not objs:
		die("no ninja object targets match %s" % cpps)
	with machine(False, "build --mine"), lock("build-linux-debug", what="build --mine"):  # one ninja per build dir
		r = subprocess.run(["nice", "-n", "10", "ninja", "-C", bd, "-k", "0"] + objs, capture_output=True, text=True, errors="replace")
	errs = error_lines(r.stdout + r.stderr, True)
	ok = r.returncode == 0 and not errs
	print("BUILD --mine %s (%d object(s)): %s" % ("PASS" if ok else "FAIL", len(objs), cpps))
	for e in errs[:30]:
		print("  " + e)
	sys.exit(0 if ok else 1)


def prune_builds():
	snaps = [d for d in glob.glob(os.path.join(HOME, "builds", "*-*")) if os.path.isdir(d)]
	snaps.sort(key=os.path.getmtime)
	pins = read_json(os.path.join(HOME, "pins.json"), [])
	snaps = [d for d in snaps if os.path.basename(d) not in pins]
	for d in snaps[:-KEEP_BUILDS]:
		shutil.rmtree(d, ignore_errors=True)
		with contextlib.suppress(OSError):
			os.remove(d + ".log")


def print_build(state):
	if state["ok"]:
		print("BUILD PASS %s (%.0fs)%s" % (state["id"], state.get("seconds", 0), ("  exe dir: " + state["dir"]) if state.get("dir") else ""))
	else:
		print("BUILD FAIL %s (%.0fs) log: %s" % (state["id"], state.get("seconds", 0), state.get("log")))
		for e in state["errors"]:
			print("  " + e)
		mine = claims()
		owners = sorted(set(a for a, paths in mine.items() for e in state["errors"] for p in paths if os.path.basename(p) in e))
		if owners:
			print("  (files claimed by: %s)" % ", ".join(owners))
		mine_files = [os.path.basename(p) for p in claims().get(AGENT, [])]
		mine_err = [e for e in state["errors"] if any(m in e for m in mine_files)]
		print("  errors in files you claimed: %s" % (len(mine_err) if mine_files else "n/a (nothing claimed)"))
		if mine_files and not mine_err:
			print("  -> probably not yours (unless a header you changed caused them): `run --last-good` runs the newest passing build, `build --until-ok` waits for a fix")
	if state.get("dirty"):
		print("  (files changed while it compiled: %s)" % ", ".join(state["dirty"][:5]))


# ---------------------------------------------------------------- sandboxes & runs

def ensure_link(link, target):
	if os.path.lexists(link):
		return
	r = subprocess.run(["cmd.exe", "/c", "mklink", "/J", winpath(link), winpath(target)], capture_output=True, text=True, cwd=HOME)
	if r.returncode != 0:
		die("couldn't create junction %s -> %s: %s" % (link, target, r.stdout + r.stderr))


def sandbox(agent):
	"""<HOME>/sandboxes/<agent>/FlexEngine/{resources,config -> repo; saved/ private}. Exes go in bin/<build>/FlexEngine/
	so the engine's ROOT_LOCATION ("../../../FlexEngine/") lands on the sandbox."""
	sb = os.path.join(HOME, "sandboxes", agent)
	fe = os.path.join(sb, "FlexEngine")
	os.makedirs(os.path.join(fe, "saved"), exist_ok=True)
	for name in ("resources", "config"):
		ensure_link(os.path.join(fe, name), os.path.join(ENGINE, name))
	os.makedirs(os.path.join(ENGINE, "saved", "fonts"), exist_ok=True)
	ensure_link(os.path.join(fe, "saved", "fonts"), os.path.join(ENGINE, "saved", "fonts"))
	return sb


def link_spv(sb, state):
	"""Point the sandbox's saved/spv at the shaders the build was made with (else an older exe gets newer shaders)."""
	link = os.path.join(sb, "FlexEngine", "saved", "spv")
	snap = os.path.join(state.get("dir") or "", "spv")
	target = snap if os.path.isdir(snap) else os.path.join(ENGINE, "saved", "spv")
	if os.path.lexists(link):
		# wslpath resolves links, so name the junction through its parent (else rmdir targets the shader folder itself)
		r = subprocess.run(["cmd.exe", "/c", "rmdir", winpath(os.path.dirname(link)) + "\\spv"], capture_output=True, text=True, cwd=HOME)
		if os.path.lexists(link):
			die("couldn't remove the sandbox's spv junction %s: %s" % (link, (r.stdout + r.stderr).strip()))
	os.makedirs(target, exist_ok=True)
	ensure_link(link, target)


def install_exe(sb, state):
	dst = os.path.join(sb, "bin", state["id"], "FlexEngine")
	if not os.path.exists(os.path.join(dst, "Flex.exe")):
		os.makedirs(dst, exist_ok=True)
		for name in os.listdir(state["dir"]):
			if name.lower().endswith((".exe", ".dll", ".pdb")):
				shutil.copy2(os.path.join(state["dir"], name), dst)
	for old in glob.glob(os.path.join(sb, "bin", "*")):
		if os.path.basename(old) != state["id"]:
			shutil.rmtree(old, ignore_errors=True)  # fails harmlessly while an old exe is still running
	return os.path.join(dst, "Flex.exe")


def kill_sandbox(sb):
	pattern = winpath(sb) + "\\*"
	ps = ("Get-Process -Name Flex -ErrorAction SilentlyContinue | Where-Object { $_.Path -like '%s' } | "
		"ForEach-Object { Stop-Process -Id $_.Id -Force; $_.Id }" % pattern)  # Get-CimInstance can hang
	try:
		r = subprocess.run(["powershell.exe", "-NoProfile", "-Command", ps], capture_output=True, text=True, timeout=30)
	except subprocess.TimeoutExpired:
		print("flexsvc: couldn't list Flex.exe processes (powershell timed out)", file=sys.stderr)
		return []
	return r.stdout.split()


def own_flexsvc_processes():
	"""Pids of this agent's other flexsvc commands (stuck runs/waits), never this process or its ancestors, so agents
	don't need `pkill -f "flexsvc -a NAME"`, which matches & kills the calling shell too."""
	skip, pid = set(), os.getpid()
	while pid > 1:
		skip.add(pid)
		try:
			pid = int(open("/proc/%d/stat" % pid).read().rsplit(")", 1)[1].split()[1])
		except (OSError, ValueError, IndexError):
			break
	found = []
	for d in os.listdir("/proc"):
		if not d.isdigit() or int(d) in skip:
			continue
		try:
			argv = open("/proc/%s/cmdline" % d, "rb").read().split(b"\0")
		except OSError:
			continue
		args = [x.decode(errors="replace") for x in argv if x]
		if any(os.path.basename(x) == "flexsvc" for x in args[:2]) and "kill" not in args and \
				("-a" in args and args[args.index("-a") + 1:args.index("-a") + 2] == [AGENT] or "--agent=" + AGENT in args):
			found.append(int(d))
	return found


def flex_processes():
	"""[(pid, exe path)] of running Flex.exe, or None if powershell timed out."""
	ps = "Get-Process -Name Flex -ErrorAction SilentlyContinue | ForEach-Object { '{0} {1}' -f $_.Id, $_.Path }"
	try:
		out = subprocess.run(["powershell.exe", "-NoProfile", "-Command", ps], capture_output=True, text=True, timeout=15).stdout
	except subprocess.TimeoutExpired:
		return None
	return [(l.strip().split(" ", 1) + [""])[:2] for l in out.splitlines() if l.strip()]


def bat_quote(v):
	return v.replace("%", "%%").replace("^", "^^").replace("&", "^&").replace("|", "^|").replace("<", "^<").replace(">", "^>")


def bat_arg(v):
	"""One command line argument in a .bat: quoted if it has spaces or cmd specials (only % needs escaping inside quotes)."""
	if any(c in v for c in " \t&|<>^()"):
		return '"%s"' % v.replace("%", "%%")
	return v.replace("%", "%%")


def run_exe(exe, args, env, timeout, perf, log, sb, label):
	"""Call with the sandbox lock held (run_flex does), so any marker left here is from a run that died or timed out."""
	marker = os.path.join(sb, "running-%d" % os.getpid())
	old = glob.glob(os.path.join(sb, "running*"))
	if old:
		for p in old:
			with contextlib.suppress(OSError):
				os.remove(p)
		killed = kill_sandbox(sb)
		if killed:
			print("killed leftover Flex.exe from an earlier run in this sandbox: %s" % killed)
	bat = os.path.join(sb, "run-%d.bat" % os.getpid())
	lines = ["@echo off"]
	if perf:
		lines.append("set VK_INSTANCE_LAYERS=")
	if not perf and not os.environ.get("FLEXSVC_FOCUS"):
		# The window shows without taking focus or input (FLEXSVC_FOCUS=1 opts out). Not for perf runs: unfocused
		# windows measured ~2x the hitches & +4ms p99 (Windows deprioritizes background windows' presents)
		lines.append("set FLEX_NO_FOCUS=1")
	lines += ["set %s=%s" % (k, bat_quote(v)) for k, v in env.items()]
	lines += ["cd /d \"%s\"" % winpath(os.path.dirname(exe)), "Flex.exe %s < nul" % " ".join(bat_arg(x) for x in args), "exit /b %errorlevel%"]
	with open(bat, "w", newline="\r\n") as f:
		f.write("\n".join(lines) + "\n")

	open(marker, "w").close()
	started = time.time()
	timed_out = False
	with open(log, "w") as out:
		p = subprocess.Popen(["cmd.exe", "/c", winpath(bat)], stdout=out, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL, cwd=sb)
		try:
			code = p.wait(timeout=timeout)
		except subprocess.TimeoutExpired:
			timed_out = True
			p.kill()
			kill_sandbox(sb)
			code = 124
	with contextlib.suppress(OSError):
		if not timed_out:
			os.remove(marker)
		os.remove(bat)
	with open(log, errors="replace") as f:
		output = f.read().replace("\r", "")
	return code, output, time.time() - started, timed_out


def summarize(output, tail):
	keep = re.compile(r"(error|warning|fail|pass|assert|crash|exception|Frame times|Hitch:|===)", re.I)
	lines = [l for l in output.splitlines() if not l.lstrip().startswith("DBG:")]  # DBG: lines are scratch prints, never failures
	hits = [l for l in lines if keep.search(l)]
	shown = hits[:40] + (["... %d more matching lines" % (len(hits) - 40)] if len(hits) > 40 else [])
	tail_lines = [l for l in lines[-tail:] if l not in shown] if tail else []
	return "\n".join(shown + (["--- last lines ---"] + tail_lines if tail_lines else []))


def existing_build(build_id):
	snap = os.path.join(HOME, "builds", build_id)
	if not os.path.isdir(snap):
		die("no build %s in %s (builds are pruned after %d; `flexsvc pin ID` keeps one)" % (build_id, os.path.dirname(snap), KEEP_BUILDS))
	return {"id": build_id, "ok": True, "dir": snap}


def last_good_state():
	good = read_json(os.path.join(HOME, "builds", "Release-good.json"))
	if not good or not os.path.isdir(good.get("dir", "")):
		die("no passing Release build yet")
	newer = [p for p in claims().get(AGENT, []) if os.path.isfile(os.path.join(REPO, p)) and os.path.getmtime(os.path.join(REPO, p)) > good["started"]]
	print("[%s] using last good build %s (%s ago)%s" % (now_str(), good["id"], "%.0fm" % ((time.time() - good["started"]) / 60),
		("; your claimed files changed since: " + ", ".join(newer)) if newer else "; none of your claimed files changed since"))
	return good


def run_flex(args, env=None, timeout=300, perf=False, fresh=False, config="Release", build_state=None, tail=15, quiet=False, sandbox_name=None, grep=None, wipe=()):
	state = build_state or build(config, quiet_cached=True)
	if not state["ok"]:
		print_build(state)
		die("not running: the current tree doesn't build", 1)
	if config != "Release":
		die("runs use Release builds (Debug writes into the shared tree's bin/, run it yourself if you need it)")
	name = sandbox_name or AGENT
	sb = sandbox(name)
	saved = os.path.join(sb, "FlexEngine", "saved")
	what = "%s run %s" % ("perf" if perf else "gpu", " ".join(args))[:120]
	runs_dir = os.path.join(scratch_dir(), "runs")
	os.makedirs(runs_dir, exist_ok=True)
	# Runs in one sandbox share its saved/, exe folder & spv link, so they take turns (lock order: sandbox, machine, gpu)
	with lock("sandbox-" + name, what=what):
		if fresh:
			for entry in os.listdir(saved):
				if entry not in ("spv", "fonts"):
					p = os.path.join(saved, entry)
					shutil.rmtree(p, ignore_errors=True) if os.path.isdir(p) and not os.path.islink(p) else os.remove(p)
		for entry in wipe:
			shutil.rmtree(os.path.join(saved, entry), ignore_errors=True)
		if "--screenshots" in args or any(k.endswith("SCREENSHOT") or k == "FLEX_GAME_TOUR" for k in (env or {})):
			shutil.rmtree(os.path.join(saved, "screenshots"), ignore_errors=True)  # so `shots diff` only sees this run's
		exe = install_exe(sb, state)
		link_spv(sb, state)
		with machine(perf, what), gpu_slot(what):
			log = os.path.join(runs_dir, "%s-%d.log" % (time.strftime("%H%M%S"), os.getpid()))
			print("[%s] running %s %s (timeout %ds)" % (now_str(), state["id"], " ".join(args), timeout), flush=True)
			code, output, seconds, timed_out = run_exe(exe, args, env or {}, timeout, perf, log, sb, what)
	if not quiet:
		if grep:
			print("\n".join(l for l in output.splitlines() if re.search(grep, l)))
		else:
			print(summarize(output, tail))
		print("RUN %s exit %d in %.0fs (build %s) log: %s" % ("TIMEOUT" if timed_out else ("OK" if code == 0 else "FAILED"), code, seconds, state["id"], log))
		print("sandbox saved/: %s" % saved)
	return code, output, state


def detach(argv):
	"""Re-run this command in the background; prints a ticket for `wait`."""
	tid = "%s-%s-%s" % (AGENT, time.strftime("%H%M%S"), os.urandom(3).hex())
	d = os.path.join(HOME, "tickets")
	os.makedirs(d, exist_ok=True)
	out = os.path.join(d, tid + ".log")
	cut = argv.index("--") if "--" in argv else len(argv)  # only drop our --detach, not one meant for Flex.exe
	cmd = [sys.executable, os.path.abspath(__file__)] + [a for a in argv[:cut] if a != "--detach"] + argv[cut:]
	base = shlex.quote(os.path.join(d, tid))
	# The exit code goes to a temp file first & is renamed, so `wait` never reads a half-written .exit
	sh = "%s > %s 2>&1; echo $? > %s.exit.tmp; mv %s.exit.tmp %s.exit" % (" ".join(shlex.quote(c) for c in cmd), shlex.quote(out), base, base, base)
	subprocess.Popen(["sh", "-c", sh], start_new_session=True, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
	print("ticket %s  (flexsvc -a %s wait %s)" % (tid, AGENT, tid))


def wait_ticket(tid, max_wait):
	d = os.path.join(HOME, "tickets")
	t0 = time.time()
	while not os.path.exists(os.path.join(d, tid + ".exit")) and time.time() - t0 < max_wait:
		time.sleep(2)
	try:
		print(open(os.path.join(d, tid + ".log"), errors="replace").read())
	except OSError:
		die("no ticket " + tid)
	if os.path.exists(os.path.join(d, tid + ".exit")):
		code = int(open(os.path.join(d, tid + ".exit")).read().strip() or 1)
		print("TICKET DONE exit %d" % code)
		sys.exit(code)
	print("TICKET STILL RUNNING after %ds: wait again" % max_wait)
	sys.exit(3)


def scratch_dir():
	d = os.path.join(HOME, "scratch", AGENT)
	os.makedirs(d, exist_ok=True)
	return d


# ---------------------------------------------------------------- bench

def parse_bench(output):
	res = {}
	m = re.search(r"Frame times \(ms\): p50 ([\d.]+), p95 ([\d.]+), p99 ([\d.]+), p99\.9 ([\d.]+), max ([\d.]+) \| (\d+) frames over 2x median \(([\d.]+)%\), (\d+) over 33ms(?:, (\d+) hitches)?", output)
	if m:
		keys = ["p50", "p95", "p99", "p999", "max", "over2x", "over2x_pct", "over33"]
		res = {k: float(v) for k, v in zip(keys, m.groups()[:8])}
		res["hitches"] = int(m.group(9) or 0)
	m = re.search(r"=== Profile \((\d+) frames, avg ([\d.]+)ms/frame", output)
	if m:
		res["frames"], res["avg"] = int(m.group(1)), float(m.group(2))
	res["hitch_lines"] = [l.strip() for l in output.splitlines() if l.startswith("Hitch:")][:15]
	scopes = re.findall(r"^\s+([\d.]+)\s+([\d.]+)\s+([\d.]+)\s+([\d.]+)\s+(\S.*)$", output.split("=== Profile")[-1] if "=== Profile" in output else "", re.M)
	res["top_scopes"] = [{"scope": s[4], "avg_ms": float(s[0]), "max_ms": float(s[2])} for s in scopes if not s[4].startswith("#")][:12]
	return res


def bench_median(state, seconds, seed, label, runs, extra_env=None):
	"""Frame time percentiles are noisy run to run (p99 can move 20%), so take the median of several runs."""
	results = [bench_once(state, seconds, seed, label, extra_env) for _ in range(runs)]
	res = dict(results[len(results) // 2])
	for k in ("p50", "p95", "p99", "p999", "max", "avg", "over2x", "over33", "hitches"):
		vals = sorted(r[k] for r in results if k in r)
		if vals:
			res[k] = vals[len(vals) // 2]
	if runs > 1:
		res["runs"] = [{k: r.get(k) for k in ("p50", "p99", "max", "hitches")} for r in results]
	return res


def bench_once(state, seconds, seed, label, extra_env=None):
	env = dict(extra_env or {}, FLEX_PLAY_BENCHMARK=str(seconds), FLEX_PLAY_SEED=str(seed))
	# worlds & terrain are wiped so every run generates from scratch, and both exes do the same work
	code, output, _ = run_flex(["--play=Bench"], env, timeout=seconds + 420, perf=True, build_state=state, quiet=True, sandbox_name=AGENT + "-bench", wipe=("worlds", "terrain"))
	res = parse_bench(output)
	res.update(build=state["id"], label=label, exit=code)
	if "p50" not in res:
		res["error"] = "no frame time line in output, see %s" % sorted(glob.glob(os.path.join(scratch_dir(), "runs", "*.log")))[-1]
	return res


def bench(seconds, seed, baseline, runs, env=None, baseline_env=None):
	if baseline and baseline != "same" and not baseline.endswith(".json"):
		existing_build(baseline)  # fail before spending minutes on the current build's run
	current = build("Release", quiet_cached=True)
	if not current["ok"]:
		print_build(current)
		die("not benchmarking: the current tree doesn't build", 1)
	result = {"current": bench_median(current, seconds, seed, "current", runs, env)}
	if baseline:
		if baseline.endswith(".json"):
			result["baseline"] = read_json(baseline, {}).get("current") or die("can't read " + baseline)
		else:
			result["baseline"] = bench_median(existing_build(baseline) if baseline != "same" else current, seconds, seed, "baseline", runs, baseline_env if baseline_env is not None else env)
		b, c = result["baseline"], result["current"]
		result["delta_ms"] = {k: round(c[k] - b[k], 2) for k in ("p50", "p95", "p99", "p999", "max", "avg") if k in b and k in c}
		result["delta_hitches"] = c.get("hitches", 0) - b.get("hitches", 0)
	out = os.path.join(HOME, "bench", "%s-%s.json" % (current["id"], time.strftime("%H%M%S")))
	os.makedirs(os.path.dirname(out), exist_ok=True)
	write_json(out, result)
	for k in ("baseline", "current"):
		if k in result:
			r = result[k]
			print("%-8s %-6s " % (k, r["build"]) + " ".join("%s %s" % (m, r.get(m)) for m in ("p50", "p95", "p99", "p999", "max", "avg", "over33", "hitches")) + (("  ERROR " + r["error"]) if "error" in r else ""))
			print("         top: " + ", ".join("%s %.2f" % (t["scope"], t["avg_ms"]) for t in r["top_scopes"][:5]))
			for line in r["hitch_lines"][:3]:
				print("         " + line[:160])
	if "delta_ms" in result:
		print("delta    " + json.dumps(result["delta_ms"]) + " hitches %+d" % result["delta_hitches"])
	print("full JSON: " + out)


# ---------------------------------------------------------------- screenshots

def shots(action, set_name):
	shots_dir = os.path.join(HOME, "sandboxes", AGENT, "FlexEngine", "saved", "screenshots")
	ref_dir = os.path.join(HOME, "refs", set_name)
	if action == "ref":
		shutil.rmtree(ref_dir, ignore_errors=True)
		shutil.copytree(shots_dir, ref_dir)
		print("saved %d reference screenshots to %s" % (len(os.listdir(ref_dir)), ref_dir))
		return
	from PIL import Image, ImageChops
	import numpy as np
	out_dir = os.path.join(scratch_dir(), "shotdiff")
	shutil.rmtree(out_dir, ignore_errors=True)
	os.makedirs(out_dir)
	refs = sorted(os.listdir(ref_dir)) if os.path.isdir(ref_dir) else die("no reference set " + ref_dir)
	bad = 0
	for name in refs:
		cur_path = os.path.join(shots_dir, name)
		if not os.path.exists(cur_path):
			print("MISSING  %s" % name)
			bad += 1
			continue
		try:
			a = Image.open(os.path.join(ref_dir, name)).convert("RGB")
			b = Image.open(cur_path).convert("RGB")
		except Exception as e:  # truncated PNG from a run that was killed
			print("CORRUPT  %s (%s)" % (name, str(e)[:80]))
			bad += 1
			continue
		if a.size != b.size:
			print("SIZE     %s %s vs %s" % (name, a.size, b.size))
			bad += 1
			continue
		d = np.asarray(ImageChops.difference(a, b), dtype=np.float32).max(axis=2)
		mean, changed = float(d.mean()), float((d > 24).mean() * 100)
		differs = mean > 2.0 or changed > 1.0
		bad += differs
		if differs:
			Image.fromarray(np.clip(d * 4, 0, 255).astype(np.uint8)).save(os.path.join(out_dir, name))
		print("%s %s  mean diff %.2f, %.2f%% pixels changed" % ("DIFF    " if differs else "same    ", name, mean, changed))
	extra = sorted(set(os.listdir(shots_dir)) - set(refs)) if os.path.isdir(shots_dir) else []
	if extra:
		print("new (not in reference): %s" % ", ".join(extra))
	print("%d of %d differ; diff images (x4 brightness): %s" % (bad, len(refs), out_dir))
	sys.exit(1 if bad else 0)


# ---------------------------------------------------------------- shaders

def compile_shaders(names):
	"""Release builds have no shader compiler, so compile changed shaders the way the engine would: includes inlined,
	glslang for Vulkan 1.2, then spirv-opt -O (unoptimized SPIR-V keeps dead samples that upset validation)."""
	sdk = sorted(glob.glob("/mnt/c/VulkanSDK/*/Bin"))
	if not sdk:
		die("no Vulkan SDK in /mnt/c/VulkanSDK")
	src_dir = os.path.join(ENGINE, "resources", "shaders")
	spv_dir = os.path.join(ENGINE, "saved", "spv")
	tmp = os.path.join(scratch_dir(), "shaders")
	os.makedirs(tmp, exist_ok=True)

	def inline(path, seen):  # seen collects the included files
		out = []
		for line in open(path, errors="replace").read().splitlines():
			m = re.match(r'\s*#include\s+"([^"]+)"', line)
			if m:
				inc = os.path.join(os.path.dirname(path), m.group(1))
				if inc not in seen:
					seen.add(inc)
					out.append(inline(inc, seen))
			else:
				out.append(line)
		return "\n".join(out)

	failed = 0
	matched = set()
	with lock("shaders"):
		for path in sorted(glob.glob(os.path.join(src_dir, "*.*"))):
			base, ext = os.path.splitext(os.path.basename(path))
			if ext not in (".vert", ".frag", ".geom", ".comp"):
				continue
			spv = os.path.join(spv_dir, "%s_%s.spv" % (base, ext[1:]))
			includes = set()
			text = inline(path, includes)
			if names:
				if not any(base == n or os.path.basename(path) == n or base.startswith(n) for n in names):
					continue
				matched.add(base)
			elif os.path.exists(spv) and os.path.getmtime(spv) >= max(os.path.getmtime(p) for p in includes | {path}):
				continue
			src = os.path.join(tmp, os.path.basename(path))
			with open(src, "w") as f:
				f.write(text + "\n")
			unopt = os.path.join(tmp, base + "_" + ext[1:] + "_unopt.spv")
			r = subprocess.run([sdk[-1] + "/glslangValidator.exe", "-V", "--target-env", "vulkan1.2", winpath(src), "-o", winpath(unopt)], capture_output=True, text=True)
			if r.returncode == 0:
				r = subprocess.run([sdk[-1] + "/spirv-opt.exe", "-O", winpath(unopt), "-o", winpath(spv)], capture_output=True, text=True)
			print("%s %s%s" % ("ok  " if r.returncode == 0 else "FAIL", os.path.basename(path), ("\n" + (r.stdout + r.stderr).replace("\r", "").strip()) if r.returncode else ""))
			failed += r.returncode != 0
	if names and not matched:
		die("no shader in %s matches %s" % (src_dir, names), 1)
	sys.exit(1 if failed else 0)


# ---------------------------------------------------------------- done & metrics

def done():
	"""Run before the final report: the newest Release build must pass & include your claimed files, and your claimed
	files must have no DBG: prints left. Releases a hold you forgot."""
	os.chdir(REPO)
	mine = [p for p in claims().get(AGENT, []) if os.path.exists(p)]
	problems = []
	with lock("board"):
		h = read_json(hold_file())
		if h and h.get("agent") == AGENT:
			os.remove(hold_file())
			problems.append("you still held builds (released now)")
	if not mine:
		problems.append("nothing claimed, so nothing could be checked (flexsvc claim PATH...)")
	if mine:
		diff = subprocess.run(["git", "diff", "-U0", "HEAD", "--"] + mine, capture_output=True, text=True, errors="replace").stdout
		untracked = subprocess.run(["git", "ls-files", "--others", "--exclude-standard", "--"] + mine, capture_output=True, text=True).stdout.split()
		dbg = [l[1:].strip() for l in diff.splitlines() if l.startswith("+") and not l.startswith("+++") and "DBG:" in l]
		for p in untracked:
			with open(p, errors="replace") as f:
				dbg += [l.strip() for l in f if "DBG:" in l]
		if dbg:
			problems.append("%d DBG: line(s) left in your files, e.g. %s" % (len(dbg), dbg[0][:120]))
	good = read_json(os.path.join(HOME, "builds", "Release-good.json"))
	last = read_json(os.path.join(HOME, "builds", "Release.json"))
	if not last or not last.get("ok"):
		problems.append("the newest Release build %s fails: `build` & check whose errors they are" % (last or {}).get("id"))
	newer = [p for p in mine if p.endswith(SRC_EXTS) and good and os.path.getmtime(p) > good["started"]]
	if newer:
		problems.append("edited after the last good build %s: %s (`build` again)" % (good["id"], ", ".join(newer)))
	if mine:
		print(subprocess.run(["git", "diff", "--stat", "HEAD", "--"] + mine, capture_output=True, text=True).stdout.rstrip() or "(no tracked changes in your claimed files)")
	history("done", ok=not problems, build=(good or {}).get("id"))
	for p in problems:
		print("DONE CHECK: " + p)
	print("DONE CHECK %s" % ("PASS" if not problems else "FAIL"))
	sys.exit(0 if not problems else 1)


def metrics():
	"""Stats for this dispatch from history.jsonl: builds, failures, minutes the shared Release tree was broken, done
	checks per agent. The manager adds them to the archive's metrics.json."""
	events = []
	with contextlib.suppress(OSError), open(os.path.join(HOME, "history.jsonl")) as f:
		events = [json.loads(l) for l in f if l.strip()]
	if not events:
		return print("no history yet (history.jsonl is written by builds & `done`)")
	builds = [e for e in events if e["event"] == "build"]
	rel = sorted((e for e in builds if e["config"] == "Release"), key=lambda e: e["started"])
	broken, since = 0.0, None
	for e in rel:
		if not e["ok"] and since is None:
			since = e["started"]
		elif e["ok"] and since is not None:
			broken += e["started"] - since
			since = None
	if since is not None:
		broken += time.time() - since
	span = (events[-1]["t"] - events[0]["t"]) / 60
	out = {"span_min": round(span), "builds": len(builds), "release_builds": len(rel), "release_failed": sum(not e["ok"] for e in rel),
		"release_broken_min": round(broken / 60), "build_min": round(sum(e["seconds"] for e in builds) / 60),
		"builds_by_agent": {}, "done_checks": {}}
	for e in builds:
		out["builds_by_agent"][e["agent"]] = out["builds_by_agent"].get(e["agent"], 0) + 1
	for e in events:
		if e["event"] == "done":
			out["done_checks"][e["agent"]] = "PASS" if e["ok"] else "FAIL"  # last check wins
	print(json.dumps(out, indent=1))


# ---------------------------------------------------------------- status & hooks

def status():
	print("board: %s   state: %s" % (board_path(), HOME))
	for key in ("Release", "Debug", "linux-debug"):
		s = read_json(os.path.join(HOME, "builds", key + ".json"))
		if s:
			print("last %s build: %s %s, %s ago, by %s" % (key, s["id"], "PASS" if s["ok"] else "FAIL", "%.0fm" % ((time.time() - s["started"]) / 60), s.get("by")))
	print("activity:")
	for p in sorted(glob.glob(os.path.join(LOCKS, "activity", "*.json"))):
		a = read_json(p)
		if not a or not os.path.exists("/proc/%d" % a["pid"]):
			with contextlib.suppress(OSError):
				os.remove(p)
			continue
		if a["lock"] in ("gate", "build-Release", "build-Debug", "build-linux-debug") or a["lock"].startswith("slot") or a["state"] == "waiting":
			print("  %-10s %-8s %-60s %4.0fs" % (a["agent"], a["state"], a["what"][:60], time.time() - a["since"]))
	procs = flex_processes()
	if procs is None:
		print("  (couldn't list Flex.exe processes: powershell timed out)")
	for pid, path in procs or []:
		print("  Flex.exe pid %s %s%s" % (pid, path, "" if "sandboxes" in path else "  (not started by flexsvc)"))
	h = read_json(hold_file())
	if h:
		print("  builds held by %s for %.0fs" % (h.get("agent"), time.time() - h.get("since", 0)))
	good = read_json(os.path.join(HOME, "builds", "Release-good.json"))
	for agent, paths in sorted(claims().items()):
		print("claims %s: %s" % (agent, ", ".join(paths)))
		if good:  # after a crash, these are the half-finished edits to check first
			newer = [p for p in paths if os.path.isfile(os.path.join(REPO, p)) and p.endswith(SRC_EXTS) and os.path.getmtime(os.path.join(REPO, p)) > good["started"]]
			if newer:
				print("  uncompiled since last good build %s: %s" % (good["id"], ", ".join(newer)))
	if good:
		os.chdir(REPO)
		changed = subprocess.run("git status --porcelain -- FlexEngine/src FlexEngine/include", shell=True, capture_output=True, text=True).stdout.split("\n")
		files = [l[3:].strip() for l in changed if l.strip()]
		newer = [p for p in files if os.path.isfile(p) and os.path.getmtime(p) > good["started"]]
		if newer:
			print("source edited since last good build %s (%d): %s" % (good["id"], len(newer), ", ".join(newer[:30])))


def hooks():
	"""Every environment variable & command line flag the engine reads, with the first comment that mentions it, so
	agents reuse hooks instead of adding new ones."""
	found, comments = {}, []
	for path in source_files():
		lines = open(path, errors="replace").read().splitlines()
		for i, line in enumerate(lines):
			if "//" in line:
				comments.append(line.split("//", 1)[1].strip())
			for m in re.finditer(r'getenv\("(FLEX_[A-Z0-9_]+)"\)|(?:strcmp|strncmp)\(argv\[i\], "(--[a-z0-9-]+=?)"', line):
				found.setdefault(m.group(1) or m.group(2), "%s:%d" % (os.path.relpath(path, ENGINE), i + 1))
	for name in sorted(found, key=lambda n: (n.startswith("FLEX"), n)):
		bare = name.rstrip("=")
		about = next((c for c in comments if re.search(r'(^|[^A-Z_a-z-])' + re.escape(bare) + r'($|[^A-Z_a-z-])', c)), "")
		print("%-27s %-36s %s" % (name, found[name], about[:200]))


# ---------------------------------------------------------------- main

def test_categories():
	return {k: v for k, v in read_json(os.path.join(REPO, "scripts", "test_categories.json"), {}).items() if not k.startswith("_")}

def affected_categories(files):
	cats = test_categories()
	hit = {c for c, d in cats.items() if any(p in f for f in files for p in d["paths"])}
	# a source file that no category claims could affect anything
	if any((f.endswith(SRC_EXTS + (".glsl", ".vert", ".frag")) or f.startswith("FlexEngine/resources/")) and not any(p in f for d in cats.values() for p in d["paths"]) for f in files):
		hit = set(cats)
	return hit

def test(cats_arg, run_all, list_only, timeout):
	"""Runs the test categories affected by your claimed files (or, with nothing claimed, the tree's uncommitted changes)."""
	os.chdir(REPO)
	cats = test_categories()
	files = claims().get(AGENT, [])
	if not files:
		files = subprocess.run(["git", "diff", "--name-only", "HEAD"], capture_output=True, text=True).stdout.split()
	files = [os.path.relpath(os.path.abspath(f), REPO).replace(os.sep, "/") for f in files]
	if run_all:
		chosen = set(cats)
	elif cats_arg:
		chosen = set(cats_arg.split(","))
		bad = chosen - set(cats)
		if bad:
			die("unknown categories %s (have %s)" % (",".join(sorted(bad)), ",".join(cats)))
	else:
		chosen = affected_categories(files)
	print("categories: %s" % (",".join(sorted(chosen)) or "none (no source changes that need tests)"))
	units = sorted({cats[c]["unit"] for c in chosen if cats[c].get("unit")})
	scenes = []
	for c in sorted(chosen):
		scenes += [s for s in cats[c]["scenes"] if s not in scenes]
	frames = max([cats[c].get("frames", 10) for c in chosen if cats[c]["scenes"]] or [10])
	if list_only:
		return print("unit: %s\nscenes (%d frames): %s" % (",".join(units), frames, " ".join(scenes)))
	code = 0
	if units:
		c, _, _ = run_flex(["--test", "--headless", "--category=" + ",".join(units)], timeout=timeout)
		code = code or c
	if scenes:
		c, _, _ = run_flex(["--test-scenes", "--frames=%d" % frames] + scenes, timeout=timeout)
		code = code or c
	print("TEST %s" % ("PASS" if code == 0 else "FAIL"))
	sys.exit(1 if code else 0)

def main():
	global AGENT
	sys.stdout.reconfigure(line_buffering=True)
	ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
	ap.add_argument("-a", "--agent", default=os.environ.get("FLEX_AGENT"))
	sub = ap.add_subparsers(dest="cmd", required=True)
	b = sub.add_parser("build")
	b.add_argument("--config", default="Release", choices=["Release", "Debug"])
	b.add_argument("--linux", action="store_true", help="ninja Debug build (compile check only, renders on llvmpipe)")
	b.add_argument("--mine", action="store_true", help="compile only your claimed .cpp files (Linux compile check)")
	b.add_argument("--until-ok", action="store_true", help="rebuild whenever sources change until the tree builds")
	b.add_argument("--max", type=int, default=100, help="seconds --until-ok may take (keep under the tool timeout)")
	r = sub.add_parser("run")
	r.add_argument("--perf", action="store_true", help="exclusive machine, validation layers off")
	r.add_argument("--timeout", type=int, default=300)
	r.add_argument("--env", action="append", default=[], metavar="K=V")
	r.add_argument("--fresh", action="store_true", help="wipe the sandbox's saved/ (worlds, caches, settings) first")
	r.add_argument("--tail", type=int, default=15)
	r.add_argument("--build", help="run an existing build id (e.g. r-12) instead of building")
	r.add_argument("--last-good", action="store_true", help="run the newest passing build, don't build")
	r.add_argument("--detach", action="store_true", help="run in the background; returns a ticket for `wait`")
	r.add_argument("--grep", help="print only output lines matching this regex")
	r.add_argument("args", nargs=argparse.REMAINDER)
	be = sub.add_parser("bench")
	be.add_argument("--seconds", type=int, default=45)
	be.add_argument("--seed", type=int, default=1)
	be.add_argument("--baseline", help="build id (e.g. r-12) to run as well, or a saved bench .json")
	be.add_argument("--runs", type=int, default=1, help="report the median of N runs of each exe")
	be.add_argument("--env", action="append", default=[], metavar="K=V", help="env for the current run")
	be.add_argument("--baseline-env", action="append", default=None, metavar="K=V", help="env for the baseline run (--baseline same re-runs the current build, for A/B of a toggle)")
	t = sub.add_parser("test", help="run the test categories your claimed files affect (see scripts/test_categories.json)")
	t.add_argument("--cat", help="comma separated categories instead of the affected ones")
	t.add_argument("--all", action="store_true", help="every category")
	t.add_argument("--list", action="store_true", help="only print what would run")
	t.add_argument("--timeout", type=int, default=600)
	p = sub.add_parser("post")
	p.add_argument("--to")
	p.add_argument("message", nargs="+")
	rd = sub.add_parser("read", aliases=["board"])
	rd.add_argument("--all", action="store_true")
	rd.add_argument("--undelivered", action="store_true", help="directed messages their addressee hasn't read (manager)")
	c = sub.add_parser("claim")
	c.add_argument("--set", action="store_true", help="replace your claims instead of adding")
	c.add_argument("--clear", action="store_true")
	c.add_argument("paths", nargs="*")
	w = sub.add_parser("wait")
	w.add_argument("ticket")
	w.add_argument("--max", type=int, default=100)
	pn = sub.add_parser("pin")
	pn.add_argument("build_id")
	s = sub.add_parser("shots")
	s.add_argument("action", choices=["ref", "diff"])
	s.add_argument("set")
	sh = sub.add_parser("shaders")
	sh.add_argument("names", nargs="*")
	for name in ("kill", "status", "hooks", "scratch", "hold", "release", "changes", "done", "metrics"):
		sub.add_parser(name)
	a = ap.parse_args()

	if a.cmd == "hooks":
		return hooks()
	AGENT = a.agent or ("user" if a.cmd in ("status", "read", "board", "post", "metrics") else None)
	if not AGENT or not re.match(r"^[A-Za-z0-9_-]+$", AGENT):
		die("pass your agent name: flexsvc -a NAME %s ... (or set FLEX_AGENT)" % a.cmd)
	os.makedirs(HOME, exist_ok=True)

	if a.cmd == "status":
		return status()
	if a.cmd == "metrics":
		return metrics()
	if a.cmd == "done":
		return done()
	if a.cmd == "post":
		return post(" ".join(a.message), a.to)
	if a.cmd in ("read", "board"):
		print("\n".join(undelivered() if a.undelivered else unread(a.all)) or "(nothing new)")
		return
	if a.cmd == "hold":
		with lock("board"):
			h = read_json(hold_file())
			if h and h.get("agent") != AGENT and time.time() - h.get("since", 0) < 600:
				die("%s already holds builds (%.0fs ago); wait for their `release` or for it to expire" % (h.get("agent"), time.time() - h["since"]), 1)
			write_json(hold_file(), {"agent": AGENT, "since": time.time()})
		return print("builds held for up to 10 min; `release` when your edit compiles")
	if a.cmd == "release":
		with lock("board"):
			h = read_json(hold_file())
			if h and h.get("agent") == AGENT:
				os.remove(hold_file())
				return print("released")
		return print("you weren't holding builds")
	if a.cmd == "pin":
		existing_build(a.build_id)
		pins = read_json(os.path.join(HOME, "pins.json"), [])
		write_json(os.path.join(HOME, "pins.json"), sorted(set(pins + [a.build_id])))
		return print("pinned " + a.build_id)
	if a.cmd == "wait":
		return wait_ticket(a.ticket, a.max)
	if a.cmd == "changes":  # for the final commit message
		os.chdir(REPO)
		return print(subprocess.run("git status --short | grep -v dependencies/; git diff --stat HEAD -- . ':!FlexEngine/dependencies'", shell=True, capture_output=True, text=True).stdout)
	if a.cmd == "claim":
		with lock("board"):
			allc = claims()
			if a.clear:
				allc.pop(AGENT, None)
			else:
				allc[AGENT] = a.paths if a.set else sorted(set(allc.get(AGENT, []) + a.paths))
			write_json(os.path.join(HOME, "claims.json"), allc)
		return
	if a.cmd == "scratch":
		return print(scratch_dir())
	if a.cmd == "kill":
		mine = own_flexsvc_processes()
		for pid in mine:
			with contextlib.suppress(OSError):
				os.kill(pid, 15)
		return print("killed Flex.exe: %s; flexsvc processes: %s" % (kill_sandbox(sandbox(AGENT)) or "nothing", mine or "none"))
	if a.cmd == "shots":
		return shots(a.action, a.set)
	if a.cmd == "shaders":
		return compile_shaders(a.names)

	show_unread()
	if a.cmd == "build":
		if a.mine:
			return build_mine()
		t0 = time.time()
		state = build(a.config, a.linux)
		while a.until_ok and not state["ok"] and time.time() - t0 < a.max:
			time.sleep(10)
			state = build(a.config, a.linux, quiet_cached=True)
		print_build(state)
		sys.exit(0 if state["ok"] else 1)
	if a.cmd == "test":
		return test(a.cat, a.all, a.list, a.timeout)
	if a.cmd == "run":
		args = a.args[1:] if a.args[:1] == ["--"] else a.args
		env = dict(kv.split("=", 1) for kv in a.env)
		if a.detach:
			return detach(sys.argv[1:])
		pinned = existing_build(a.build) if a.build else (last_good_state() if a.last_good else None)
		code, _, _ = run_flex(args, env, a.timeout, a.perf, a.fresh, tail=a.tail, build_state=pinned, grep=a.grep)
		sys.exit(code)
	if a.cmd == "bench":
		kv = lambda l: dict(x.split("=", 1) for x in l)
		return bench(a.seconds, a.seed, a.baseline, a.runs, kv(a.env), kv(a.baseline_env) if a.baseline_env is not None else None)


if __name__ == "__main__":
	main()
